--- src/app/globals.css
+++ src/app/globals.css
@@ -340,2 +340,20 @@
 .pricing-more { color: var(--gold) !important; font-style: italic; }
 .pricing-cta { width: 100%; text-align: center; }
+
+/* ==========================================================================
+   11. CATEGORY PREVIEW (HOME)
+   ========================================================================== */
+.category-preview-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 32px; margin-bottom: 48px; }
+.category-preview-card { background: var(--bg-card); border: 1px solid var(--border-light); border-radius: 4px; padding: 48px; text-align: center; transition: var(--transition-smooth); position: relative; overflow: hidden; }
+.category-preview-card::before { content: ''; position: absolute; top: 0; left: 0; width: 100%; height: 4px; background: var(--gold); transform: scaleX(0); transition: var(--transition-smooth); transform-origin: left; }
+.category-preview-card:hover::before { transform: scaleX(1); }
+.category-preview-card:hover { transform: translateY(-5px); box-shadow: 0 10px 40px rgba(0,0,0,0.3); border-color: var(--border); }
+.category-preview-card.featured { border-color: var(--gold); background: linear-gradient(to bottom, var(--bg-elevated), var(--background)); }
+.category-preview-card.featured::before { transform: scaleX(1); background: var(--gold-light); }
+.cp-icon { font-size: 3rem; color: var(--gold); font-family: var(--font-playfair); margin-bottom: 24px; font-style: italic; }
+.cp-title { font-family: var(--font-playfair); font-size: 2rem; color: var(--text-primary); margin-bottom: 16px; }
+.cp-desc { font-size: 1rem; color: var(--text-secondary); margin-bottom: 32px; line-height: 1.6; max-width: 400px; margin-left: auto; margin-right: auto; }
+.cp-price { margin-bottom: 32px; font-size: 0.875rem; color: var(--text-secondary); text-transform: uppercase; letter-spacing: 1px; }
+.cp-price span { display: block; font-family: var(--font-playfair); font-size: 2rem; color: var(--gold); margin-top: 8px; font-weight: 600; text-transform: none; letter-spacing: 0; }
+
